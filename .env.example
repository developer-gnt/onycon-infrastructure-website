# ==============================================================================
# ONYCON Infrastructure — Frontend Environment Variables
# ==============================================================================
# Copy to .env.local for local testing or configure in Vercel Project Settings.
# IMPORTANT: Only public (VITE_*) non-secret configuration belongs here.
# NEVER put private API keys, SMTP passwords, or database secrets in VITE_ vars.

# Optional: Public HTTPS form endpoint (e.g. Formspree, Web3Forms, Basin, or custom API)
# When unset, the Contact Us form validates locally in demo/frontend-only mode.
VITE_CONTACT_FORM_ENDPOINT=""

# Optional: Production base URL used for documentation/reference (update index.html,
# public/robots.txt, and public/sitemap.xml with your live domain before launch).
VITE_SITE_URL="https://www.onycon-placeholder-domain.com"
